<?php
// Ativar exibição de erros para desenvolvimento
ini_set('display_errors', 1);
error_reporting(E_ALL);

// Conexão com o Banco de Dados
try {
    $pdo = new PDO("mysql:host=localhost;dbname=pharmora_db;charset=utf8mb4", "root", "", [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC
    ]);
} catch (Exception $e) {
    die("Erro de conexão: " . $e->getMessage());
}

$mensagemsucesso = "";

// PROCESSAMENTO DO FORMULÁRIO (SALVAMENTO VIA POST)
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    try {
        $pdo->beginTransaction();
        
        $configuracoesParaSalvar = [
            'nome_empresa'          => $_POST['nome_empresa'] ?? '',
            'nif_empresa'           => $_POST['nif_empresa'] ?? '',
            'telefone_empresa'      => $_POST['telefone_empresa'] ?? '',
            'email_empresa'         => $_POST['email_empresa'] ?? '',
            'endereco_empresa'      => $_POST['endereco_empresa'] ?? '',
            'moeda_padrao'          => $_POST['moeda_padrao'] ?? 'Kz',
            'iva_padrao'            => $_POST['iva_padrao'] ?? '0.00',
            'limite_alerta_estoque' => $_POST['limite_alerta_estoque'] ?? '5'
        ];

        $sql_update = "UPDATE sistema_definicoes SET valor = :valor WHERE chave = :chave";
        $stmt = $pdo->prepare($sql_update);

        foreach ($configuracoesParaSalvar as $chave => $valor) {
            $stmt->execute([
                ':valor' => htmlspecialchars(trim($valor)),
                ':chave' => $chave
            ]);
        }

        $pdo->commit();
        $mensagemsucesso = "Configurações atualizadas com sucesso!";
    } catch (Exception $e) {
        $pdo->rollBack();
        $mensagemerro = "Erro ao salvar alterações: " . $e->getMessage();
    }
}

// BUSCA AS CONFIGURAÇÕES ATUAIS PARA PREENCHER O FORMULÁRIO
$stmt = $pdo->query("SELECT chave, valor FROM sistema_definicoes");
$configs = [];
while ($row = $stmt->fetch()) {
    $configs[$row['chave']] = $row['valor'];
}
