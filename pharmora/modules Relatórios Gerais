<?php
// 1. CONEXÃO COM O BANCO DE DADOS (Padrão MySQLi usado no teu sistema)
$conn = new mysqli("localhost", "root", "", "pharmora_db");
if ($conn->connect_error) { 
    die("Erro de Conexão: " . $conn->connect_error); 
}

// 2. QUERY: BALANÇO GERAL (DRE SIMPLIFICADO)
$sql_balanco = "SELECT 
                    SUM(CASE WHEN tipo = 'RECEITA' THEN valor_liquido ELSE 0.00 END) AS total_receitas,
                    SUM(CASE WHEN tipo = 'DESPESA' THEN valor_liquido ELSE 0.00 END) AS total_despesas,
                    SUM(CASE WHEN tipo = 'PERDA' THEN valor_liquido ELSE 0.00 END) AS total_perdas
                FROM financeiro_movimentacoes";
$res_balanco = $conn->query($sql_balanco);
$dados_balanco = $res_balanco->fetch_assoc();

$receitas = $dados_balanco['total_receitas'] ?? 0.00;
$despesas = $dados_balanco['total_despesas'] ?? 0.00;
$perdas   = $dados_balanco['total_perdas'] ?? 0.00;
$lucro_liquido = $receitas - ($despesas + $perdas);

// 3. QUERY: FATURAMENTO POR MÉTODO DE PAGAMENTO
$sql_metodos = "SELECT metodo_pagamento, COUNT(*) AS qtd, SUM(valor_liquido) AS total 
                FROM financeiro_movimentacoes 
                WHERE tipo = 'RECEITA' AND origem = 'VENDA' 
                GROUP BY metodo_pagamento ORDER BY total DESC";
$res_metodos = $conn->query($sql_metodos);

// 4. QUERY: DIAGNÓSTICO DE CONTAS A PAGAR
$sql_contas = "SELECT status_conta, COUNT(*) AS qtd, SUM(valor_original) AS total_orig, SUM(valor_pago) AS total_pago 
               FROM financeiro_contas_pagar GROUP BY status_conta";
$res_contas = $conn->query($sql_contas);

// 5. QUERY: RANKING DE PERDAS DE ESTOQUE (Casando com a tua nova tabela 'perdas')
$sql_perdas_res = "SELECT motivo, COUNT(*) AS qtd, SUM(quantidade) AS itens, SUM(valor_prejuizo_total) AS total_prejuizo 
                   FROM perdas GROUP BY motivo ORDER BY total_prejuizo DESC";
$res_perdas_res = $conn->query($sql_perdas_res);
?>
