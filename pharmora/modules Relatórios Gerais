<?php

class PharmoraRelatorios {
    private $pdo;

    public function __construct(PDO $pdo) {
        $this->pdo = $pdo;
    }

    /**
     * 1. BALANÇO FINANCEIRO GERAL (DRE SIMPLIFICADO)
     * Retorna o total de receitas, despesas, perdas e o lucro líquido do período.
     */
    public function obterBalancoGeral(string $dataInicio, string $dataFim): array {
        $sql = "SELECT 
                    SUM(CASE WHEN tipo = 'RECEITA' THEN valor_liquido ELSE 0.00 END) AS total_receitas,
                    SUM(CASE WHEN tipo = 'DESPESA' THEN valor_liquido ELSE 0.00 END) AS total_despesas,
                    SUM(CASE WHEN tipo = 'PERDA' THEN valor_liquido ELSE 0.00 END) AS total_perdas
                FROM financeiro_movimentacoes
                WHERE data_registro BETWEEN :inicio AND :fim";

        $stmt = $this->pdo->prepare($sql);
        $stmt->execute([
            ':inicio' => $dataInicio . ' 00:00:00',
            ':fim'    => $dataFim . ' 23:59:59'
        ]);

        $dados = $stmt->fetch(PDO::FETCH_ASSOC);
        
        // Garantir que valores nulos retornem 0
        $receitas = $dados['total_receitas'] ?? 0.00;
        $despesas = $dados['total_despesas'] ?? 0.00;
        $perdas = $dados['total_perdas'] ?? 0.00;
        
        // Cálculo do Lucro Líquido Real
        $lucroLiquido = $receitas - ($despesas + $perdas);

        return [
            'total_receitas' => (float)$receitas,
            'total_despesas' => (float)$despesas,
            'total_perdas'   => (float)$perdas,
            'lucro_liquido'  => (float)$lucroLiquido
        ];
    }

    /**
     * 2. FATURAMENTO POR MÉTODO DE PAGAMENTO
     * Identifica quais canais de entrada trazem mais dinheiro (Dinheiro, POS, M-Pesa, E-mola, etc.)
     */
    public function obterFaturamentoPorMetodo(string $dataInicio, string $dataFim): array {
        $sql = "SELECT metodo_pagamento, 
                       COUNT(*) AS quantidade_vendas,
                       SUM(valor_liquido) AS total_faturado
                FROM financeiro_movimentacoes
                WHERE tipo = 'RECEITA' AND origem = 'VENDA'
                  AND data_registro BETWEEN :inicio AND :fim
                GROUP BY metodo_pagamento
                ORDER BY total_faturado DESC";

        $stmt = $this->pdo->prepare($sql);
        $stmt->execute([
            ':inicio' => $dataInicio . ' 00:00:00',
            ':fim'    => $dataFim . ' 23:59:59'
        ]);

        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }

    /**
     * 3. DIAGNÓSTICO DE CONTAS A PAGAR
     * Agrupa as contas por status para entender o endividamento e compromissos futuros.
     */
    public function obterResumoContasAPagar(): array {
        $sql = "SELECT status_conta,
                       COUNT(*) AS quantidade_contas,
                       SUM(valor_original) AS total_original,
                       SUM(valor_pago) AS total_pago,
                       SUM(CASE WHEN status_conta IN ('PENDENTE', 'VENCIDO') THEN (valor_original - valor_pago) ELSE 0.00 END) AS total_pendente
                FROM financeiro_contas_pagar
                GROUP BY status_conta
                ORDER BY total_original DESC";

        $stmt = $this->pdo->query($sql);
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }

    /**
     * 4. RANKING E ANÁLISE DE PERDAS DE ESTOQUE
     * Mapeia os principais motivos de prejuízo na farmácia (Ex: Validade, Quebra).
     */
    public function obterResumoPerdas(string $dataInicio, string $dataFim): array {
        $sql = "SELECT motivo,
                       COUNT(*) AS total_ocorrencias,
                       SUM(quantidade) AS produtos_perdidos,
                       SUM(valor_prejuizo) AS prejuizo_financeiro
                FROM produtos_perdas
                WHERE data_registro BETWEEN :inicio AND :fim
                GROUP BY motivo
                ORDER BY prejuizo_financeiro DESC";

        $stmt = $this->pdo->prepare($sql);
        $stmt->execute([
            ':inicio' => $dataInicio . ' 00:00:00',
            ':fim'    => $dataFim . ' 23:59:59'
        ]);

        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }

    /**
     * 5. EVOLUÇÃO DOS CUSTOS DE PESSOAL (FOLHA DE PAGAMENTO)
     * Consolida os gastos reais com funcionários por competência (Mês/Ano).
     */
    public function obterCustosComPessoal(int $ano): array {
        $sql = "SELECT mes_referencia,
                       COUNT(DISTINCT id_funcionario) AS total_funcionarios,
                       SUM(salario_base) AS total_salario_base,
                       SUM(subsidios_bonus) AS total_beneficios,
                       SUM(descontos_faltas + descontos_impostos) AS total_retencoes,
                       SUM(valor_pago_liquido) AS custo_real_caixa
                FROM financeiro_pagamentos_funcionarios
                WHERE ano_referencia = :ano AND status_pagamento = 'PAGO'
                GROUP BY mes_referencia
                ORDER BY mes_referencia ASC";

        $stmt = $this->pdo->prepare($sql);
        $stmt->execute([':ano' => $ano]);

        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
}
